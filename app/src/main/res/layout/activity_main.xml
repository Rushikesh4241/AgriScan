<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/farmer_bg">


    <!-- 👤 PROFILE ICON -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_profile"
        android:background="@drawable/circle_bg"
        android:padding="8dp"
        android:elevation="6dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>


    <!-- 🔰 LOGO CENTER TOP (PROPER FIX) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoCard"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#33FFFFFF">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:cropToPadding="false"/>

    </com.google.android.material.card.MaterialCardView>


    <!-- 📜 MAIN CONTENT -->
    <ScrollView
        android:layout_below="@id/logoCard"
        android:layout_above="@id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 🔲 MAIN CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#CCFFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AgriScan 🌱"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart Plant Disease Detection"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- BUTTONS -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGallery"
                        style="@style/AgriButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gallery"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCamera"
                        style="@style/AgriButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Camera"
                        android:layout_marginTop="10dp"/>

                    <!-- IMAGE -->
                    <ImageView
                        android:id="@+id/imgPreview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>

                    <!-- 🔁 CHANGE IMAGE -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangeImage"
                        style="@style/AgriButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change Image"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"/>

                    <!-- 🔍 PREDICT -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPredict"
                        style="@style/AgriButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Predict"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EXTRA FEATURES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#CCFFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbout"
                        style="@style/AgriButtonOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="About Us"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWeather"
                        style="@style/AgriButtonOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Weather Info"
                        android:layout_marginTop="10dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistory"
                        style="@style/AgriButtonOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Prediction History"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 🔻 FOOTER -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#0A1A2F"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- LOGO -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:background="@drawable/circle_bg"
            android:padding="6dp"/>

        <!-- SCROLLING TEXT -->
        <TextView
            android:id="@+id/txtFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="AgriScan 🌱 | Smart Farming with AI | Empowering Farmers | © 2026 AGRISCAN"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"/>
    </LinearLayout>

</RelativeLayout>